# Copie para .env (nunca suba o .env para o git). Sem estas variáveis o app roda em MODO LOCAL:
# sem login e com os dados guardados no navegador (IndexedDB).

# Front-end (públicas por natureza; a proteção dos dados é a RLS do Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só nas Netlify Functions (Site configuration > Environment variables). NUNCA no front-end.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
SUPABASE_SERVICE_ROLE_KEY=
